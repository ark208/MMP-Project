# Server Port & Host
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# PostgreSQL Database Connection
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/campusloop?schema=public"

# Authentication
JWT_SECRET=super-secret-jwt-key-replace-in-production
JWT_EXPIRES_IN=7d

# File Uploads (Local disk or S3/Cloudinary)
UPLOAD_DIR=./uploads

