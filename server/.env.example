# Server Port & Environment
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# Database Connection (PostgreSQL 16)
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/campusloop?schema=public"

# In-Memory Database Fallback (set to true when running locally without a live PostgreSQL daemon)
USE_MEMORY_DB=false

# Authentication & Campus Domain Restrictions
JWT_SECRET=dev-secret-campusloop-key-min-32-chars-long
JWT_EXPIRES_IN=7d
ALLOWED_EMAIL_DOMAIN=campus.edu

# File Uploads (Local disk or Cloudinary)
UPLOAD_DIR=./uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email Delivery (Nodemailer SMTP - in development, OTPs are logged to console)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@campusloop.internal
